# Source this file in the training shell after supplying the empty model/data values.
# The dependency profiles have different Python/PyTorch requirements. Use separate environments.

# Policy and reward model identifiers or local directories.
GEOTRACE_MODEL=
PRM_BASE_MODEL=
GEOTRACE_TEXT_PRM=
GEOTRACE_PRM_DEVICE=cpu
# Feature-head baseline checkpoint. The text workflow uses GEOTRACE_TEXT_PRM.
GEOTRACE_PRM_CHECKPOINT=

# Modes: tool_agent or single_turn. Rewards: process or outcome.
GEOTRACE_ROLLOUT_MODE=tool_agent
GEOTRACE_REWARD_MODE=process
GEOTRACE_DATA_DIR=outputs/verl_data
GEOTRACE_CHECKPOINT_DIR=outputs/grpo_checkpoints
# PPO has a separate default to avoid restoring a critic-free checkpoint.
GEOTRACE_PPO_CHECKPOINT_DIR=outputs/ppo_checkpoints
# Native launchers require a stable experiment ID and existing Ray Jobs endpoint.
GEOTRACE_RAY_JOB_ADDRESS=http://127.0.0.1:8265
GEOTRACE_MONITOR_DIR=
GEOTRACE_LEDGER_FILE=
# Optional coordinator-owned W&B metrics and interruption/threshold alerts.
GEOTRACE_MONITOR_WANDB_PROJECT=
# Optional custom TOML. Otherwise the installed package supplies its defaults.
# GEOTRACE_PRM_CONFIG=/path/to/prm.toml

# Set the parser required by the chosen policy model, such as its documented tool format.
TOOL_PARSER=
VLLM_USE_V1=1
VLLM_API_KEY=

# Public dataset release record used with the import command.
SURVEY_RELEASE_URL=

# W&B is optional. Supply credentials only in your local environment.
WANDB_API_KEY=
WANDB_PROJECT=geotrace
WANDB_MODE=offline

# Set to 1 only when opting into actual local Ray crash/recovery tests.
GEOTRACE_TEST_RAY=0

# Shared runtime TOML and JSON log context.
GEOTRACE_CONFIG=configs/recovery.toml
GEOTRACE_LOG_LEVEL=INFO
GEOTRACE_RUN_ID=local
GEOTRACE_RAY_ADDRESS=
VLLM_ENDPOINT=http://127.0.0.1:8000/v1
GEOTRACE_HTTP_TIMEOUT=120
GEOTRACE_RECOVERY_RETRIES=3
GEOTRACE_RECOVERY_BACKOFF=2
